  [campeonatos.bin]
}

[main.cpp]          --> [Controller.h]
[Controller.cpp]    --> [View.h]
[Controller.cpp]    --> [PilotoView.h]
[Controller.cpp]    --> [EquipaView.h]
[Controller.cpp]    --> [VeiculoView.h]
[Controller.cpp]    --> [CorridaView.h]
[Controller.cpp]    --> [ParticipacaoView.h]
[Controller.cpp]    --> [CampeonatoView.h]
[Controller.cpp]    --> [PilotoService.h]
[Controller.cpp]    --> [EquipaService.h]
[Controller.cpp]    --> [VeiculoService.h]
[Controller.cpp]    --> [CorridaService.h]
[Controller.cpp]    --> [ParticipacaoService.h]
[Controller.cpp]    --> [CampeonatoService.h]

[PilotoService.cpp]       --> [IRacingRepository.h]
[EquipaService.cpp]       --> [IRacingRepository.h]
[VeiculoService.cpp]      --> [IRacingRepository.h]
[CorridaService.cpp]      --> [IRacingRepository.h]
[ParticipacaoService.cpp] --> [IRacingRepository.h]
[CampeonatoService.cpp]   --> [IRacingRepository.h]

[RacingRepositoryBin.cpp] --> [RacingApp.h]
[RacingRepositoryBin.cpp] --> [pilotos.bin]
[RacingRepositoryBin.cpp] --> [equipas.bin]

@startuml

title Package Diagram - Estrutura do Projeto C++ CLI

package "main" {
  [main.cpp]
}

package "ui" {
  [Menu.h / Menu.cpp]
  [PilotoUI.h / PilotoUI.cpp]
  [EquipaUI.h / EquipaUI.cpp]
  [VeiculoUI.h / VeiculoUI.cpp]
  [CorridaUI.h / CorridaUI.cpp]
  [ParticipacaoUI.h / ParticipacaoUI.cpp]
}

package "controller" {
  [PilotoController.h / .cpp]
  [EquipaController.h / .cpp]
  [VeiculoController.h / .cpp]
  [CorridaController.h / .cpp]
  [ParticipacaoController.h / .cpp]
}

package "store" {
  [PilotoStore.h / .cpp]
  [EquipaStore.h / .cpp]
  [VeiculoStore.h / .cpp]
  [CorridaStore.h / .cpp]
  [ParticipacaoStore.h / .cpp]
}

package "model" {
  [Piloto.h / .cpp]
  [Equipa.h / .cpp]
  [Veiculo.h / .cpp]
  [Corrida.h / .cpp]
  [Participacao.h / .cpp]
}

package "data" <<folder>> {
  [pilotos.bin]
  [equipas.bin]
  [veiculos.bin]
  [corridas.bin]
  [participacoes.bin]
}

[main.cpp]         --> [Menu.h / Menu.cpp]
[Menu.h / Menu.cpp] --> [PilotoUI.h / PilotoUI.cpp]

@startuml

title Use Cases - Software de Gestão de Pilotos de Automobilismo

actor Utilizador

rectangle "Sistema de Gestão de Pilotos" {

  ' --- Piloto ---
  usecase "Criar Piloto"           as UC1
  usecase "Listar Pilotos"         as UC2

  ' --- Equipa ---
  usecase "Criar Equipa"           as UC3
  usecase "Listar Equipas"         as UC4

  ' --- Veiculo ---
  usecase "Criar Veículo"          as UC5
  usecase "Listar Veículos"        as UC6

  ' --- Corrida ---
  usecase "Criar Corrida"          as UC7
  usecase "Listar Corridas"        as UC8

  ' --- Participação ---
  usecase "Registar Participação"  as UC9
  usecase "Consultar Classificação" as UC10

  ' --- Sub-steps (included) ---
  usecase "Selecionar Piloto"      as UC11
  usecase "Selecionar Corrida"     as UC12
}

Utilizador --> UC1
Utilizador --> UC2
Utilizador --> UC3
Utilizador --> UC4
Utilizador --> UC5
Utilizador --> UC6
Utilizador --> UC7
Utilizador --> UC8
Utilizador --> UC9
Utilizador --> UC10

UC9  .>  UC11 : <<include>>
UC9  .>  UC12 : <<include>>
UC10 .>  UC12 : <<include>>

@enduml
